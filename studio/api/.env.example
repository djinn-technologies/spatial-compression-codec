# 12-factor configuration. Copy to .env (which is gitignored) and edit.

# --- Server ---------------------------------------------------------------
HOST=0.0.0.0
PORT=8080
NODE_ENV=production
LOG_LEVEL=info

# --- Database -------------------------------------------------------------
# The control plane connects with a role that does NOT have BYPASSRLS.
# Every request begins with `SET LOCAL app.tenant_id = '<uuid>'`; RLS
# policies then filter rows by tenant. See docs/adr/ADR-012.
DATABASE_URL=postgres://scc_app:<password>@localhost:5432/scc_studio
DATABASE_MAX_POOL_SIZE=20

# --- Auth -----------------------------------------------------------------
# JWT public key (RS256). Multi-line PEM; encode the newlines as \n if
# the env source is single-line.
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
JWT_ISSUER=https://auth.example.com/
JWT_AUDIENCE=scc-studio

# --- Agent IPC ------------------------------------------------------------
# Path to the scc-studio-agent's Unix socket. Must be reachable from the
# API process. On a typical deployment the agent runs as a sidecar and
# the socket is in a shared volume.
SCC_AGENT_SOCKET=/run/scc/scc-agent.sock

# --- Rate limit -----------------------------------------------------------
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW=1 minute

# --- Observability --------------------------------------------------------
# When set, OTLP traces + metrics are exported. Empty disables the
# exporter (logs still print to stderr via pino).
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=scc-studio-api

# --- Swagger UI -----------------------------------------------------------
# Swagger UI is exposed at /api/docs ONLY in non-production by default.
# Override here if you want it on in production (NOT recommended).
SWAGGER_UI_ENABLED=auto
