%%{init: {'theme':'neutral'}}%%
flowchart TB
    capture["📷 Capture Operator<br/>(camera rig / sensor host)"]:::actor
    viewer["👤 Playback Viewer<br/>(end user)"]:::actor
    devops["🛠 DevOps / Integrator"]:::actor

    scc["Spatial Compression Codec (SCC)<br/><i>Depth-aware codec, SDK and reference app<br/>for RGB-D 3D-video streaming &amp; recording</i>"]:::system

    sensor[("RGB-D Sensor<br/>(Kinect, RealSense,<br/>Stereolabs ZED, ToF)")]:::external
    h264["H.264 / AVC Codec<br/>(libx264, hardware NVENC/QSV)"]:::external
    streaming["Streaming Servers<br/>(WebRTC SFU, RTMP, HLS)"]:::external
    storage["Object Storage<br/>(S3, R2, Azure Blob)"]:::external
    djinn["Djinn Volumetric<br/>Visualisation Stack"]:::external

    capture -->|RGB-D frames| scc
    sensor -->|RGB + depth (raw)| scc
    scc -->|H.264 + depth SEI| streaming
    scc -->|.mp4 + depth SEI| storage
    streaming -->|H.264 + SEI| scc
    storage -->|H.264 + SEI| scc
    scc -->|RGB + reconstructed depth| djinn
    djinn -->|rendered 3D scene| viewer
    devops -->|API config, encoding params| scc

    classDef actor fill:#08427B,color:#fff,stroke:#052E56
    classDef system fill:#1168BD,color:#fff,stroke:#0B4884
    classDef external fill:#999999,color:#fff,stroke:#6B6B6B
