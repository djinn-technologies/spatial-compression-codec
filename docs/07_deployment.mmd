%%{init: {'theme':'neutral'}}%%
flowchart TB
    internet(("🌐 Internet"))

    subgraph edge["Edge / CDN"]
        cdn["Cloudflare CDN<br/>(static FE + WASM)"]:::external
    end

    subgraph cloud["Cloud — Akuma Engineering AWS account (eu-west-2)"]
        subgraph public_subnet["Public Subnet"]
            alb["Application Load Balancer<br/>(TLS 1.3, HSTS)"]:::container
            sfu["WebRTC SFU<br/>(mediasoup, EC2 m6i.large)"]:::container
        end
        subgraph private_subnet["Private Subnet"]
            api1["API Node 1<br/>(ECS Fargate)"]:::container
            api2["API Node 2<br/>(ECS Fargate)"]:::container
            redis[("Redis<br/>(ElastiCache, t4g.small)")]:::datastore
            rds[("PostgreSQL 16<br/>(RDS, t4g.medium)")]:::datastore
        end
        s3[("S3 — Recording Bucket<br/>(SSE-KMS, lifecycle 90d → IA)")]:::datastore
        kms["AWS KMS<br/>(per-tenant CMK)"]:::external
    end

    subgraph onprem["On-Prem / Edge Devices"]
        agentDev["Capture Agent<br/>(Linux/Win/macOS, native)"]:::container
        sensor[("RGB-D Sensor")]:::external
    end

    internet --> cdn
    internet --> alb
    cdn -->|FE assets| internet
    alb --> api1
    alb --> api2
    api1 --> redis
    api2 --> redis
    api1 --> rds
    api2 --> rds
    api1 --> s3
    s3 --> kms
    sensor --> agentDev
    agentDev -->|H.264+SEI over QUIC/SRT| sfu
    sfu -->|H.264+SEI| internet

    classDef container fill:#1168BD,color:#fff,stroke:#0B4884
    classDef datastore fill:#1168BD,color:#fff,stroke:#0B4884
    classDef external fill:#999999,color:#fff,stroke:#6B6B6B
