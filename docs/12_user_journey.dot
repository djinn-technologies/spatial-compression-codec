digraph Journey {
  rankdir=LR;
  graph [bgcolor=white, fontname=Helvetica, fontsize=11, nodesep=0.3, ranksep=0.5, compound=true];
  node  [fontname=Helvetica, fontsize=9, shape=box, style="rounded,filled", fillcolor="#1168BD", fontcolor=white, margin=0.14];
  edge  [fontname=Helvetica, fontsize=8];

  subgraph cluster_onboard {
    label="① Onboard"; style="rounded"; color="#0B4884"; fontcolor="#0B4884";
    j1 [label="Install SCC Studio\n(web + agent)"];
    j2 [label="Connect RGB-D sensor\n(USB / SDK)"];
    j3 [label="Sign in / load\ntenant profile"];
  }
  subgraph cluster_config {
    label="② Configure"; style="rounded"; color="#0B4884"; fontcolor="#0B4884";
    j4 [label="Pick encoding profile\n(lossless / lossy / streaming)"];
    j5 [label="Tune bit-depth\n(8 / 12 / 16)"];
    j6 [label="Toggle motion-aware\ninterlacing"];
  }
  subgraph cluster_capture {
    label="③ Capture"; style="rounded"; color="#0B4884"; fontcolor="#0B4884";
    j7 [label="Start recording"];
    j8 [label="Live preview:\nPSNR + bitrate readout"];
    j9 [label="Stop recording"];
  }
  subgraph cluster_deliver {
    label="④ Deliver"; style="rounded"; color="#0B4884"; fontcolor="#0B4884";
    j10 [label="Upload .mp4 with SCC SEI\nto S3"];
    j11 [label="Share viewer URL"];
    j12 [label="Viewer plays back\nin 3D viewport"];
  }

  j1->j2->j3->j4;
  j4->j5->j6->j7;
  j7->j8->j9->j10;
  j10->j11->j12;
}
